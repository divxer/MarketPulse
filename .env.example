APP_PASSWORD_HASH=
SESSION_SECRET=change-me-32-bytes-of-randomness-please
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./marketpulse.db
WATCHLIST_RECAP_TIME=16:30
LOG_LEVEL=INFO
AI_MODEL=claude-sonnet-4-6
# Optional premium model for /stock AI deep analysis only. Empty = use AI_MODEL.
# Example: AI_MODEL_ANALYZE=claude-opus-4-7
AI_MODEL_ANALYZE=
# Phase 3: cheap model for the strategy router stage (Haiku-class).
# Defaults to claude-haiku-4-5 — DON'T leave empty in production, the
# fallback is AI_MODEL (Sonnet) which costs ~100x more per router call.
AI_MODEL_ROUTER=claude-haiku-4-5
AI_CACHE_TTL_HOURS=24
NEWS_CACHE_TTL_DAYS=7
QUOTE_CACHE_TTL_SECONDS=300
# QUOTE_SOURCE: auto (Tencent first, yfinance fallback) | tencent | yfinance
QUOTE_SOURCE=auto

# Price alert notifications. Pick ONE transport, leave the rest blank.
# Supported NOTIFIER_KIND values: "none" | "bark" | "serverchan" | "smtp"
NOTIFIER_KIND=none
ALERT_DEBOUNCE_MINUTES=60

# Bark (iOS app — bark.day.app). Get URL after installing the app.
NOTIFIER_BARK_URL=

# Server 酱 (WeChat push — sct.ftqq.com). Get the SendKey after login.
NOTIFIER_SERVERCHAN_KEY=

# Email via SMTP (e.g. Gmail / 163 / QQ Mail app passwords).
NOTIFIER_SMTP_HOST=
NOTIFIER_SMTP_PORT=587
NOTIFIER_SMTP_USER=
NOTIFIER_SMTP_PASSWORD=
NOTIFIER_EMAIL_FROM=
NOTIFIER_EMAIL_TO=

# Daily recap push (uses the same notifier as alerts above)
NOTIFIER_RECAP_ENABLED=true
# Optional — adds a "详情" link in pushed summaries pointing back to the web UI
PUBLIC_BASE_URL=

# Outbound HTTP proxy (for reaching Anthropic etc. from blocked regions).
# Compose file maps host.docker.internal → host-gateway, so you can point at
# a proxy running on the NAS host (e.g. Mihomo/Clash at :7892).
HTTP_PROXY=
HTTPS_PROXY=
# httpx (used by TencentClient) doesn't recognize the `*.domain.com` wildcard
# format — it goes through httpcore's proxy resolver which only matches
# leading-dot suffix or explicit hostnames. Without the proper format, Tencent
# requests get routed through Clash/Mihomo to overseas exit nodes, where
# Tencent's CDN terminates the TLS handshake (SSL UNEXPECTED_EOF_WHILE_READING).
NO_PROXY=localhost,127.0.0.1,.gtimg.cn,qt.gtimg.cn,web.ifzq.gtimg.cn

# ─────────────────────────────────────────────────────────────────────────
# Phase 7a-Flex — IBKR read-only broker truth capture via Flex Web Service
# ─────────────────────────────────────────────────────────────────────────
# No Gateway sidecar required. Snapshots are pulled via IBKR's official
# Flex Web Service (HTTPS+XML). See docs/operations/ibkr-readonly-sync-runbook.md
# for the one-time IBKR Portal setup (create an Activity Flex Query + token).

# Required to enable Flex sync. Token is a 64-char secret from IBKR Portal →
# Reports → Flex Queries → Configure (gear icon) → Token Renewal.
IBKR_FLEX_TOKEN=

# Activity Flex Query ID (integer) from IBKR Portal → Reports → Flex Queries.
# Create one query that includes Account Information, Cash Report, Open Positions,
# and Trades sections.
IBKR_FLEX_QUERY_ID=

# Account ID (DU<digits> for paper, U<digits> for live). Recommended; required if
# your Flex Query returns multiple accounts.
IBKR_ACCOUNT_ID=

# Live-account safety brake. The sync refuses to capture any non-paper account
# unless this is explicitly set to true. "unknown" account classifications
# also trip this brake (defense in depth).
MP_IBKR_ALLOW_LIVE=false

# Flex tunables (defaults are sensible; uncomment to override):
# IBKR_FLEX_POLL_INTERVAL_SECONDS=5
# IBKR_FLEX_MAX_WAIT_SECONDS=60
# IBKR_FLEX_BASE_URL=https://gdcdyn.interactivebrokers.com/Universal/servlet
