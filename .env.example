APP_PASSWORD_HASH=
SESSION_SECRET=change-me-32-bytes-of-randomness-please
ANTHROPIC_API_KEY=
DATABASE_URL=sqlite:///./marketpulse.db
WATCHLIST_RECAP_TIME=16:30
LOG_LEVEL=INFO
AI_MODEL=claude-sonnet-4-6
# Optional premium model for /stock AI deep analysis only. Empty = use AI_MODEL.
# Example: AI_MODEL_ANALYZE=claude-opus-4-7
AI_MODEL_ANALYZE=
# Phase 3: cheap model for the strategy router stage (Haiku-class).
# Defaults to claude-haiku-4-5 — DON'T leave empty in production, the
# fallback is AI_MODEL (Sonnet) which costs ~100x more per router call.
AI_MODEL_ROUTER=claude-haiku-4-5
AI_CACHE_TTL_HOURS=24
NEWS_CACHE_TTL_DAYS=7
QUOTE_CACHE_TTL_SECONDS=300
# QUOTE_SOURCE: auto (Tencent first, yfinance fallback) | tencent | yfinance
QUOTE_SOURCE=auto

# Price alert notifications. Pick ONE transport, leave the rest blank.
# Supported NOTIFIER_KIND values: "none" | "bark" | "serverchan" | "smtp"
NOTIFIER_KIND=none
ALERT_DEBOUNCE_MINUTES=60

# Bark (iOS app — bark.day.app). Get URL after installing the app.
NOTIFIER_BARK_URL=

# Server 酱 (WeChat push — sct.ftqq.com). Get the SendKey after login.
NOTIFIER_SERVERCHAN_KEY=

# Email via SMTP (e.g. Gmail / 163 / QQ Mail app passwords).
NOTIFIER_SMTP_HOST=
NOTIFIER_SMTP_PORT=587
NOTIFIER_SMTP_USER=
NOTIFIER_SMTP_PASSWORD=
NOTIFIER_EMAIL_FROM=
NOTIFIER_EMAIL_TO=

# Daily recap push (uses the same notifier as alerts above)
NOTIFIER_RECAP_ENABLED=true
# Optional — adds a "详情" link in pushed summaries pointing back to the web UI
PUBLIC_BASE_URL=

# Outbound HTTP proxy (for reaching Anthropic etc. from blocked regions).
# Compose file maps host.docker.internal → host-gateway, so you can point at
# a proxy running on the NAS host (e.g. Mihomo/Clash at :7892).
HTTP_PROXY=
HTTPS_PROXY=
# httpx (used by TencentClient) doesn't recognize the `*.domain.com` wildcard
# format — it goes through httpcore's proxy resolver which only matches
# leading-dot suffix or explicit hostnames. Without the proper format, Tencent
# requests get routed through Clash/Mihomo to overseas exit nodes, where
# Tencent's CDN terminates the TLS handshake (SSL UNEXPECTED_EOF_WHILE_READING).
NO_PROXY=localhost,127.0.0.1,.gtimg.cn,qt.gtimg.cn,web.ifzq.gtimg.cn,ib-gateway

# ─────────────────────────────────────────────────────────────────────────
# Phase 7a — IBKR read-only broker truth capture (gnzsnz/ib-gateway service)
# ─────────────────────────────────────────────────────────────────────────
# All variables below feed the `ib-gateway` service in docker-compose.cn.yml
# / docker-compose.prod.yml. The marketpulse container talks to the
# gateway over the compose network at ib-gateway:4002 (paper) — no host
# port bind needed on the API socket.

# IBKR account credentials. Paper accounts are FREE — sign up at
# interactivebrokers.com → "Open Account" → paper trading. Paper account
# IDs are formatted DUxxxxxxx. NOTE: paper accounts have a SEPARATE
# password from your live account; IBKR forces you to set it on first
# paper login.
IBKR_USERNAME=
IBKR_PASSWORD=
# Account ID (DUxxxxxxx). Recommended; if unset and IBKR returns
# multiple accounts, the sync fails closed.
IBKR_ACCOUNT_ID=

# Trading mode: "paper" or "live". KEEP THIS AT "paper" UNTIL you have
# explicitly designed and tested write paths in Phase 7b/7c. ib-gateway
# will refuse the wrong port; our adapter also refuses live ports unless
# MP_IBKR_ALLOW_LIVE=true is set explicitly.
IBKR_TRADING_MODE=paper

# Read-Only API enforcement at the TWS/Gateway level. "yes" prevents the
# Gateway from accepting ANY mutating API call (placeOrder/cancelOrder/
# etc.) even if our code accidentally tries. Defense in depth — the
# adapter already has a guard test that no production code calls these
# methods, but flipping this OFF requires conscious operator action.
IBKR_READ_ONLY_API=yes

# Where to bind the Gateway's VNC server (TCP 5900). Used ONLY for the
# one-time GUI setup (verify Read-Only API checkbox, set Trusted IPs).
# After first boot you almost never need it. Bind options:
#   "127.0.0.1:5900" — localhost only (need SSH tunnel / Tailscale to reach)
#   "192.168.50.29:5900" — your NAS LAN IP (Mac on same LAN can connect)
#   "0.0.0.0:5900" — any interface (LAN-exposed; do NOT public-internet)
# DO NOT expose 5900 to the public internet; VNC is not encrypted.
IB_GATEWAY_VNC_BIND=192.168.50.29:5900

# VNC password — required by gnzsnz/ib-gateway. Pick a 6–8 char password
# (VNC limits to 8 chars). This protects the GUI in case of LAN
# compromise; it's NOT the IBKR password.
VNC_SERVER_PASSWORD=

# IBKR adapter knobs (have sensible defaults; uncomment to override):
# IBKR_HOST=ib-gateway              # docker DNS name of the gateway service
# IBKR_PORT=4002                    # Gateway paper port (live is 4001)
# IBKR_CLIENT_ID=71                 # any unique-per-connection int
# IBKR_CONNECT_TIMEOUT_SECONDS=10
# MP_IBKR_ALLOW_LIVE=false          # safety brake; do NOT enable casually
